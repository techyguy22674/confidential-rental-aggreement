{
  "version": 2,
  "rewrites": [
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/apply", "destination": "/checkin.html" },
    { "source": "/submit", "destination": "/submit.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/inspector", "destination": "/inspector.html" },
    { "source": "/explorer", "destination": "/explorer.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
